# All optional. The app runs fully on local mock data without any of these.
# Never commit real keys — copy to .env.local instead.

# "overture" (default): real Madinah places bundled from Overture Maps open data (scripts/import-overture.py)
# "sample": the fictional prototype dataset
# "http": a custom backend implementing the REST contract in src/services/httpRestaurantService.ts
VITE_RESTAURANT_SOURCE=overture
VITE_RESTAURANT_API_URL=

# Map tiles. Defaults to OpenStreetMap (no key required). Use "schematic" to force the offline map.
VITE_MAP_PROVIDER=leaflet
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
